# Project Sentinel - Environment Variables Template

# --- Server Configuration ---
PORT=3000
DATABASE_URL=mongodb://localhost:27017/sentinel
NODE_ENV=development

# --- Authentication ---
# Strategy: 'email' or 'pythagora_oauth'
AUTH_STRATEGY=email
JWT_SECRET=your_super_secret_jwt_key_change_me
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_change_me

# --- OAuth (Required if AUTH_STRATEGY is 'pythagora_oauth') ---
PYTHAGORA_IDP_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# --- Client Configuration ---
CLIENT_URL=http://localhost:5173
